{
  "name": "ai-automation-workflows",
  "version": "1.0.0",
  "description": "TypeScript-based AI automation and chatbot workflows with ethical AI considerations",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/examples/chatbot-demo.js",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "ai",
    "automation",
    "chatbot",
    "typescript",
    "gpt",
    "artificial-intelligence",
    "workflow",
    "ethics",
    "gdpr"
  ],
  "author": "Gergana Nikolova",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "dotenv": "^16.3.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
